[flake8]
max-line-length = 88
max-complexity = 10
select = C,E,F,W,B,B950
ignore = E203,E501,W503,E701,E704
exclude =
    .git,
    __pycache__,
    *.egg-info,
    .nox,
    .venv,
    .pytest_cache,
    .mypy_cache
    */generated*
    */migrations
# The billing drills under hack/billing are hand-run analyses against a staging
# database: each phase checks a different invariant, so the branching is the
# workload rather than an accident of it. Splitting them to satisfy a complexity
# number would scatter one procedure across helpers and make a manual run harder
# to follow, which is the opposite of what a drill needs. They ship in no
# distribution; the rest of the repository, including every importable module, is
# still held to the limit.
per-file-ignores =
    hack/billing/*: C901
